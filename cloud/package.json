{
  "name": "cloud",
  "version": "0.1.0",
  "bin": {
    "cloud": "bin/cloud.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy": "cdk deploy -c deployInitialVersion=no",
    "deploy-version": "./refresh.sh && cdk deploy -c deployInitialVersion=yes",
    "deploy-staging": "cdk deploy --parameters environmentName=staging"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1148.1",
    "eslint": "^10.15.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "@aws-cdk/aws-codestar-alpha": "^2.182.0-alpha.0 ",
    "aws-cdk-lib": "^2.277.0",
    "aws-sdk": "^2.1693.0",
    "constructs": "^10.0.0"
  }
}
